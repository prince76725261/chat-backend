# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/whatsapp_clone
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/whatsapp_clone?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_clone

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- CORS ----
CLIENT_URL=http://localhost:5173
